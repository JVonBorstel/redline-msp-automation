  "kb": [
    {
      "id": "KB-LL-001",
      "title": "Re-register MFA after a lost or replaced phone",
      "category": "identity",
      "tags": ["mfa", "authenticator", "phone", "lost", "new"],
      "body": "Call the person back on the number in the firm's contact list (never a number given in the ticket), reset MFA with lead approval, then guide re-registration at next sign-in."
    },
    {
      "id": "KB-LL-002",
      "title": "Leaver checklist for attorneys and staff",
      "category": "identity",
      "tags": ["leaver", "offboarding", "disable", "litigation", "hold"],
      "body": "Confirm the last day with the office administrator, check with the managing partner whether a litigation hold applies, disable the account, then convert the mailbox to shared with the hold kept in place."
    },
    {
      "id": "KB-LL-003",
      "title": "Court e-filing portal rejects an upload",
      "category": "software",
      "tags": ["efiling", "e-filing", "court", "portal", "pdf", "upload", "rejected"],
      "body": "Save the document as PDF/A with fonts embedded, keep each file under the portal's size limit, and use the supported browser. If the portal itself is down, note the time for the filing record."
    },
    {
      "id": "KB-LL-004",
      "title": "Large print jobs stuck on the copier",
      "category": "hardware",
      "tags": ["printer", "copier", "print", "stuck", "queue", "filing"],
      "body": "Cancel the stuck job from the copier panel, then print in sections of 50 pages or less. If the copier shows an error code, note it for the copier vendor."
    },
    {
      "id": "KB-LL-005",
      "title": "Document management client will not open or sync",
      "category": "software",
      "tags": ["dms", "document", "management", "sync", "workspace", "outlook", "add-in"],
      "body": "Sign out of the document management client and back in, then re-enable its Outlook add-in from File, Options, Add-ins. Never copy matter documents to the desktop as a workaround."
    },
    {
      "id": "KB-LL-006",
      "title": "Access to the docketing calendar and shared mailboxes",
      "category": "email",
      "tags": ["docketing", "calendar", "shared", "mailbox", "access"],
      "body": "Access to the docketing calendar or a shared mailbox is approved by the office administrator; once added, allow up to an hour for Outlook to show it."
    },
    {
      "id": "KB-LL-007",
      "title": "Sending large or confidential files to clients and opposing counsel",
      "category": "email",
      "tags": ["large", "file", "send", "secure", "share", "confidential", "attachment"],
      "body": "Use the firm's secure share link with an expiry date instead of email attachments or personal file services, and send the link only to the address on the matter."
    },
    {
      "id": "KB-LL-008",
      "title": "Suspicious email or a change to payment or trust account details",
      "category": "security",
      "tags": ["phishing", "suspicious", "email", "wire", "trust", "account", "bank", "report"],
      "body": "Use the Report button in Outlook and do not click links. Any change to wire or trust account instructions is confirmed by calling the client on the number already in the matter file, never a number in the email."
    },
    {
      "id": "KB-LL-009",
      "title": "Remote access from home or the courthouse",
      "category": "network",
      "tags": ["vpn", "remote", "courthouse", "home", "wifi", "disconnect"],
      "body": "Connect to the VPN only on a trusted network or your phone's hotspot, not courthouse guest Wi-Fi. If it disconnects on a schedule, check the session timeout on the VPN profile."
    },
    {
      "id": "KB-LL-010",
      "title": "Dictation headset or software not working",
      "category": "software",
      "tags": ["dictation", "headset", "microphone", "audio", "transcription"],
      "body": "Plug the headset straight into the laptop rather than the dock, choose it as the input device in the dictation software, then restart the software."
    }
  ]

# Copy to .env (git-ignored) and fill in locally. Never commit .env. Values below are non-secret defaults only.
# Default model backend: a local open-weight model behind an OpenAI-compatible endpoint (Ollama shown).
MODEL_PROVIDER=mock
MODEL_BASE_URL=http://localhost:11434/v1
MODEL_NAME=
PROVIDERS_ENABLED=mock
AUDIT_LOG_PATH=./data/audit/audit.jsonl
# Hosted providers are OFF by default. If ever enabled, keys come from Key Vault or your shell, never this file:
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Optional test Microsoft 365 tenant (Phase 3+, only if you create one):
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redline-msp-automation.example/schemas/lever-registry.schema.json",
  "$comment": "Generated by tools/gen_schemas.py from core.levers.registry._RegistryFile with levers: list[core.levers.models.LeverDef]. Do not edit by hand; run the script.",
  "$defs": {
    "Impact": {
      "additionalProperties": false,
      "description": "Who a lever affects, one line per level: L1 one person, L2 the client business, L3 the MSP, L4 the community.",
      "properties": {
        "L1": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[^\\r\\n]+$",
          "title": "L1",
          "type": "string"
        },
        "L2": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[^\\r\\n]+$",
          "title": "L2",
          "type": "string"
        },
        "L3": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[^\\r\\n]+$",
          "title": "L3",
          "type": "string"
        },
        "L4": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[^\\r\\n]+$",
          "title": "L4",
          "type": "string"
        }
      },
      "required": [
        "L1",
        "L2",
        "L3",
        "L4"
      ],
      "title": "Impact",
      "type": "object"
    },
    "LeverCaps": {
      "additionalProperties": false,
      "description": "Blast-radius limits of one write lever (B-42, HO-6).",
      "properties": {
        "targets_per_run": {
          "minimum": 1,
          "title": "Targets Per Run",
          "type": "integer"
        },
        "executes_per_client_per_hour": {
          "minimum": 1,
          "title": "Executes Per Client Per Hour",
          "type": "integer"
        },
        "clients_per_day": {
          "minimum": 1,
          "title": "Clients Per Day",
          "type": "integer"
        }
      },
      "required": [
        "targets_per_run",
        "executes_per_client_per_hour",
        "clients_per_day"
      ],
      "title": "LeverCaps",
      "type": "object"
    },
    "LeverDef": {
      "additionalProperties": false,
      "description": "One registered lever. Permissions live here, not in the model's output.",
      "properties": {
        "name": {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "client_scope": {
          "anyOf": [
            {
              "const": "any",
              "type": "string"
            },
            {
              "items": {
                "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
                "type": "string"
              },
              "type": "array"
            }
          ],
          "title": "Client Scope"
        },
        "required_role": {
          "$ref": "#/$defs/Role"
        },
        "dry_run_role": {
          "anyOf": [
            {
              "$ref": "#/$defs/Role"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "class": {
          "enum": [
            "read",
            "write"
          ],
          "title": "Class",
          "type": "string"
        },
        "approval": {
          "enum": [
            "none",
            "lead"
          ],
          "title": "Approval",
          "type": "string"
        },
        "idempotency_keys": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Idempotency Keys",
          "type": "array"
        },
        "params": {
          "additionalProperties": {
            "$ref": "#/$defs/ParamSpec"
          },
          "title": "Params",
          "type": "object"
        },
        "dry_run": {
          "title": "Dry Run",
          "type": "boolean"
        },
        "timeout_s": {
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Timeout S",
          "type": "number"
        },
        "risk_class": {
          "anyOf": [
            {
              "enum": [
                "R0",
                "R1",
                "R2",
                "R3"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Risk Class"
        },
        "reversibility": {
          "enum": [
            "reversible",
            "irreversible",
            "n/a"
          ],
          "title": "Reversibility",
          "type": "string"
        },
        "undo": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Undo"
        },
        "undo_of": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Undo Of"
        },
        "lever_version": {
          "default": 1,
          "minimum": 1,
          "title": "Lever Version",
          "type": "integer"
        },
        "impact": {
          "anyOf": [
            {
              "$ref": "#/$defs/Impact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "verification": {
          "anyOf": [
            {
              "enum": [
                "requester",
                "requester+contact"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verification"
        },
        "min_approvers": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Approvers"
        },
        "graph_scopes": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9.]{2,63}$",
            "type": "string"
          },
          "title": "Graph Scopes",
          "type": "array"
        },
        "caps": {
          "anyOf": [
            {
              "$ref": "#/$defs/LeverCaps"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "window": {
          "anyOf": [
            {
              "enum": [
                "business-hours",
                "maintenance"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window"
        },
        "preauthorized_containment": {
          "default": false,
          "title": "Preauthorized Containment",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "description",
        "client_scope",
        "required_role",
        "class",
        "approval",
        "params",
        "dry_run",
        "timeout_s",
        "reversibility"
      ],
      "title": "LeverDef",
      "type": "object"
    },
    "ParamSpec": {
      "additionalProperties": false,
      "description": "Schema for one lever parameter: type, required, enum, max length, regex (and integer bounds).",
      "properties": {
        "type": {
          "enum": [
            "string",
            "integer",
            "boolean"
          ],
          "title": "Type",
          "type": "string"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "enum": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enum"
        },
        "max_length": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Length"
        },
        "pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pattern"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        }
      },
      "required": [
        "type"
      ],
      "title": "ParamSpec",
      "type": "object"
    },
    "Role": {
      "enum": [
        "agent",
        "technician",
        "lead"
      ],
      "title": "Role",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "maximum": 1,
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "levers": {
      "items": {
        "$ref": "#/$defs/LeverDef"
      },
      "title": "Levers",
      "type": "array"
    }
  },
  "required": [
    "version",
    "levers"
  ],
  "title": "LeverRegistryFile",
  "type": "object"
}

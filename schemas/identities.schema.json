{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redline-msp-automation.example/schemas/identities.schema.json",
  "$comment": "Generated by tools/gen_schemas.py from core.identity.store._IdentityFile. Do not edit by hand; run the script.",
  "$defs": {
    "Identity": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "display_name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "clients": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Clients",
          "type": "array"
        }
      },
      "required": [
        "id",
        "display_name",
        "role",
        "clients"
      ],
      "title": "Identity",
      "type": "object"
    },
    "Role": {
      "enum": [
        "agent",
        "technician",
        "lead"
      ],
      "title": "Role",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "maximum": 1,
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "identities": {
      "items": {
        "$ref": "#/$defs/Identity"
      },
      "minItems": 1,
      "title": "Identities",
      "type": "array"
    }
  },
  "required": [
    "version",
    "identities"
  ],
  "title": "_IdentityFile",
  "type": "object"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redline-msp-automation.example/schemas/audit-record.schema.json",
  "$comment": "Hand-written (B-13). v1 mirrors core/audit/chain.py (RECORD_FIELDS, AuditLog.append) exactly. v2 mirrors the B-17 writer (RECORD_FIELDS_V2, MODES, EVENTS, ACTOR_KINDS); tests compare these enums to core.audit. Shape only: the hash chain itself is proven by core.audit.verify, not by this schema.",
  "title": "AuditRecord",
  "description": "One line of the append-only, hash-chained audit log (v1 or v2).",
  "oneOf": [{"$ref": "#/$defs/V1"}, {"$ref": "#/$defs/V2"}],
  "$defs": {
    "Hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "Timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "description": "UTC, milliseconds, Z suffix (chain._utc_now)."
    },
    "Capped": {"type": "string", "maxLength": 128, "description": "Capped at 128 characters before writing (STD-AU-6)."},
    "Mode": {
      "enum": ["dry-run", "execute", "approve", "reject", "pause", "resume", "invalid"],
      "description": "core.audit.MODES (DR-04): the runner writes dry-run and execute, the queue approve and reject, the pause switch pause and resume; invalid stands in for any other value a caller passed."
    },
    "V1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "ts", "agent", "client", "lever", "params", "mode", "result", "approver", "prev_hash", "hash"],
      "properties": {
        "seq": {"type": "integer", "minimum": 1},
        "ts": {"$ref": "#/$defs/Timestamp"},
        "agent": {"$ref": "#/$defs/Capped"},
        "client": {"anyOf": [{"$ref": "#/$defs/Capped"}, {"type": "null"}]},
        "lever": {"$ref": "#/$defs/Capped"},
        "params": {"type": "object"},
        "mode": {"$ref": "#/$defs/Mode"},
        "result": {"type": "object"},
        "approver": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "prev_hash": {"$ref": "#/$defs/Hash"},
        "hash": {"$ref": "#/$defs/Hash"}
      }
    },
    "V2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v", "seq", "ts", "agent", "client", "lever", "params", "mode", "result", "approver", "prev_hash", "hash",
        "event", "actor_kind", "lever_version", "request_id"
      ],
      "properties": {
        "v": {"const": 2},
        "seq": {"type": "integer", "minimum": 1},
        "ts": {"$ref": "#/$defs/Timestamp"},
        "agent": {"$ref": "#/$defs/Capped", "description": "Kept as 'agent' for chain compatibility; documentation calls it actor (STD-AU-3)."},
        "client": {"anyOf": [{"$ref": "#/$defs/Capped"}, {"type": "null"}]},
        "lever": {"$ref": "#/$defs/Capped"},
        "params": {"type": "object"},
        "mode": {"$ref": "#/$defs/Mode"},
        "result": {"type": "object"},
        "approver": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "prev_hash": {"$ref": "#/$defs/Hash"},
        "hash": {"$ref": "#/$defs/Hash"},
        "event": {"enum": ["lever.invoke", "lever.pause", "proposal.add", "proposal.decide", "model.complete", "job.run"]},
        "actor_kind": {"enum": ["agent", "human", "unknown"]},
        "lever_version": {"anyOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    }
  }
}
